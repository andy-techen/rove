---
import { BUTTONDOWN_USER } from '../site'

// Buttondown takes the form post directly, so the page needs no script.
const action = `https://buttondown.com/api/emails/embed-subscribe/${BUTTONDOWN_USER}`
---

{
  BUTTONDOWN_USER && (
    <section class="section updates" aria-labelledby="updates-title">
      <div class="wrap updates-inner" data-reveal>
        <div>
          <h2 id="updates-title">Hear what’s new</h2>
          <p class="muted">
            An email when there’s something worth singing about. No more than that.
          </p>
        </div>
        <form action={action} method="post" target="_blank" class="updates-form">
          <label for="updates-email" class="visually-hidden">
            Your email
          </label>
          <input
            id="updates-email"
            type="email"
            name="email"
            required
            autocomplete="email"
            placeholder="you@example.com"
          />
          <button type="submit" class="button button-secondary">
            Get updates
          </button>
        </form>
      </div>
    </section>
  )
}

<style>
  .updates {
    background: var(--color-surface-raised);
  }

  .updates-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-9);
  }

  .updates-inner p {
    margin-top: var(--space-5);
  }

  .updates-form {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
  }

  input {
    flex: 1 1 auto;
    width: var(--site-size-input-max);
    max-width: 100%;
    min-height: var(--site-size-button);
    padding-inline: var(--space-8);
    border: var(--size-hairline) solid var(--color-border);
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    color: var(--color-text);
    font: inherit;
  }
</style>
