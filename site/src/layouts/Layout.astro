---
import '@app/renderer/src/styles/tokens.css'
import '@fontsource/fredoka/600.css'
import '../styles/site.css'
import iconUrl from '@app/renderer/src/components/ui/Logo/icon.svg'
import Logo from '../components/Logo.astro'
import Icon from '../components/Icon.astro'
import tokensCss from '@app/renderer/src/styles/tokens.css?raw'
import siteCss from '../styles/site.css?raw'
import { THEME_KEY, pinnedThemes } from '../theme'
import { JOIN_FORM_URL } from '../site'

interface Props {
  title: string
  description: string
  /** A class for <body>: `dusk` turns the page from afternoon to evening as it scrolls. */
  bodyClass?: string
}

const { title, description, bodyClass } = Astro.props
// The site is rebuilt on every release, so the year stays current.
const year = new Date().getFullYear()
// BASE_URL is '/rove' with no trailing slash, so add one before joining paths.
const home = import.meta.env.BASE_URL.replace(/\/?$/, '/')
const path = Astro.url.pathname.replace(/\/$/, '')
// The home page turns from afternoon to evening as it scrolls, whatever the theme, so
// it has no theme switch.
const themeSwitch = bodyClass !== 'dusk'
const current = (page: string): 'page' | undefined => (path.endsWith(`/${page}`) ? 'page' : undefined)
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href={iconUrl.src} />
    <meta name="color-scheme" content="light dark" />
    <!-- Before the page paints, so a chosen theme never flashes the other one. -->
    <script is:inline define:vars={{ THEME_KEY }}>
      try {
        const theme = localStorage.getItem(THEME_KEY)
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme
      } catch {
        // Storage can be blocked; the site then follows the system.
      }
    </script>
    <style is:inline set:html={pinnedThemes([tokensCss, siteCss])}></style>
  </head>
  <body class={bodyClass}>
    <header class="site-header">
      <div class="wrap site-header-inner">
        <a href={home} class="home"><Logo /></a>
        <nav aria-label="Main">
          <a href={`${home}#features`} class="nav-features">Features</a>
          <a href={`${home}about/`} class="nav-about" aria-current={current('about')}>About</a>
          <a href={`${home}community/`} class="nav-community" aria-current={current('community')}
            >Community</a
          >
          {
            themeSwitch && (
              <button type="button" class="theme-switch" aria-label="Switch theme">
                <span class="theme-to-dark">
                  <Icon name="moon" />
                </span>
                <span class="theme-to-light">
                  <Icon name="sun" />
                </span>
              </button>
            )
          }
          <a href={`${home}#download`} class="button button-primary nav-download">Download</a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap site-footer-inner">
        <div class="footer-brand">
          <a href={home} class="home"><Logo /></a>
          <p class="small muted">Made by and for people who love to sing.</p>
          <div class="footer-meta">
            <nav class="footer-nav" aria-label="Footer">
              <a href={`${home}about/`}>About</a>
              <a href={`${home}community/`}>Community</a>
            </nav>
            <p class="muted">© {year} Rove</p>
          </div>
        </div>
        <form class="join" action={JOIN_FORM_URL || undefined} method="post">
          <label for="join-email" class="join-title">Be there when the community opens.</label>
          <div class="join-field">
            <input
              id="join-email"
              type="email"
              name="email_address"
              required
              autocomplete="email"
              placeholder="Your email"
            />
            <button type="submit" class="button button-primary" disabled={!JOIN_FORM_URL}>
              Join
            </button>
          </div>
          <p class="join-status" role="status" aria-live="polite"></p>
        </form>
      </div>
    </footer>
    <script>
      import { THEME_KEY, type Scheme } from '../theme'

      // The theme switch: shows and names the theme it switches to, and remembers the
      // choice. Until one is made, the site follows the system.
      const themeSwitch = document.querySelector<HTMLButtonElement>('.theme-switch')
      if (themeSwitch) {
        const root = document.documentElement
        const systemDark = matchMedia('(prefers-color-scheme: dark)')
        const showing = (): Scheme =>
          (root.dataset.theme as Scheme | undefined) ?? (systemDark.matches ? 'dark' : 'light')
        const next = (): Scheme => (showing() === 'dark' ? 'light' : 'dark')
        const name = (): void => {
          const label = `Switch to ${next()} mode`
          themeSwitch.setAttribute('aria-label', label)
          themeSwitch.title = label
        }
        name()
        systemDark.addEventListener('change', name)
        themeSwitch.addEventListener('click', () => {
          const theme = next()
          root.dataset.theme = theme
          try {
            localStorage.setItem(THEME_KEY, theme)
          } catch {
            // Not remembered, but still switched for this page.
          }
          name()
        })
      }

      // Join sends the email to Kit in place, so the visitor stays on the page and hears
      // back here. Without a script, the form still posts and Kit shows its own page.
      const join = document.querySelector<HTMLFormElement>('form.join')
      const joinStatus = join?.querySelector<HTMLElement>('.join-status')
      if (join?.action && joinStatus) {
        const JOIN_MESSAGES = {
          success: 'You’re on the list! See you when it opens.',
          invalid: 'That email doesn’t look quite right. Try it again?',
          offline: 'Couldn’t reach the list just now. Try again in a moment.'
        }
        const say = (text: string, failed: boolean): void => {
          joinStatus.textContent = text
          joinStatus.classList.toggle('join-failed', failed)
        }
        join.addEventListener('submit', async (event) => {
          event.preventDefault()
          const button = join.querySelector('button')
          if (button) button.disabled = true
          try {
            const response = await fetch(join.action, {
              method: 'POST',
              body: new FormData(join),
              headers: { Accept: 'application/json' }
            })
            const result: { status?: string } = await response.json()
            if (result.status === 'success') {
              join.reset()
              say(JOIN_MESSAGES.success, false)
            } else {
              say(JOIN_MESSAGES.invalid, true)
            }
          } catch {
            say(JOIN_MESSAGES.offline, true)
          } finally {
            if (button) button.disabled = false
          }
        })
      }

      // Reveal sections as they scroll in. Skipped for reduced motion.
      const items = document.querySelectorAll('[data-reveal]')
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('reveal-ready')
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue
              entry.target.classList.add('revealed')
              observer.unobserve(entry.target)
            }
          },
          { rootMargin: '0px 0px -10% 0px' }
        )
        items.forEach((item) => observer.observe(item))
      }
    </script>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--site-layer-header);
    background: color-mix(in srgb, var(--color-bg) 85%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: var(--size-hairline) solid var(--color-border);
  }

  .site-header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    height: var(--site-header);
  }

  .home {
    display: flex;
    text-decoration: none;
  }

  .site-header nav {
    display: flex;
    align-items: center;
    gap: var(--space-9);
    font-size: var(--site-font-small);
  }

  .site-header nav a:not(.button) {
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .site-header nav a:not(.button):hover,
  .site-header nav a[aria-current='page'] {
    color: var(--color-text);
  }

  /* Phones have room for one more thing beside Download: Community, or the theme switch
     where there is one. The footer still links to both pages. */
  @media (max-width: 480px) {
    .site-header nav {
      gap: var(--space-7);
    }

    .nav-features,
    .nav-about,
    .site-header nav:has(.theme-switch) .nav-community {
      display: none;
    }
  }

  /* The theme switch shows the theme it goes to: a moon by day, a sun by night. */
  .theme-switch {
    display: grid;
    place-items: center;
    width: var(--size-control-md);
    aspect-ratio: 1;
    padding: 0;
    border: none;
    border-radius: var(--radius-md);
    background: none;
    color: var(--color-text-muted);
    font-size: var(--size-icon-primary);
    cursor: pointer;
    transition:
      background var(--duration-fast),
      color var(--duration-fast);
  }

  .theme-switch:hover {
    background: var(--color-highlight);
    color: var(--color-text);
  }

  .theme-to-dark {
    display: flex;
  }

  .theme-to-light,
  :global(:root[data-theme='dark']) .theme-to-dark {
    display: none;
  }

  :global(:root[data-theme='dark']) .theme-to-light {
    display: flex;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .theme-to-light {
      display: flex;
    }

    :global(:root:not([data-theme='light'])) .theme-to-dark {
      display: none;
    }
  }

  .nav-download {
    min-height: auto;
    padding-block: var(--space-4);
    padding-inline: var(--space-8);
  }

  /* A band in the cards' warm grey, so the page ends clearly without a marigold tint,
     which turns brown in the dark theme. */
  .site-footer {
    padding-block: var(--space-12);
    border-top: var(--size-hairline) solid var(--color-border);
    background: var(--color-surface);
  }

  /* Two columns that weigh the same: who we are on the left, the invitation on the
     right, both starting from the same top line. */
  .site-footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: start;
    justify-content: space-between;
    gap: var(--space-10) var(--space-12);
  }

  .join {
    display: grid;
    gap: var(--space-6);
    width: min(100%, var(--site-size-input-max));
  }

  .join-title {
    font-family: var(--site-font-display);
    font-size: var(--site-font-h3);
    font-weight: var(--font-weight-semibold);
  }

  .footer-brand {
    display: grid;
    justify-items: start;
    gap: var(--space-6);
  }

  .footer-meta,
  .footer-nav {
    display: flex;
    gap: var(--space-9);
    white-space: nowrap;
  }

  /* Fine print under the tagline: a step smaller, so the tagline leads. */
  .footer-meta {
    font-size: var(--font-size-caption);
  }

  .footer-nav a {
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .footer-nav a:hover {
    color: var(--color-text);
  }

  /* The field and its button read as one pill, with the button tucked inside. */
  .join-field {
    display: flex;
    padding: var(--space-2);
    border: var(--size-hairline) solid var(--color-border);
    border-radius: var(--radius-pill);
    background: var(--color-bg);
    transition: border-color var(--duration-fast);
  }

  .join-field:focus-within {
    border-color: var(--color-accent);
  }

  .join-field input {
    flex: 1 1 auto;
    min-width: 0;
    padding-inline: var(--space-7);
    border: none;
    background: none;
    color: var(--color-text);
    font: inherit;
    font-size: var(--site-font-small);
  }

  .join-field input:focus-visible {
    outline: none;
  }

  .join-field .button {
    min-height: var(--size-control-md);
    padding-inline: var(--space-8);
    font-size: var(--site-font-small);
  }

  .join-status {
    color: var(--color-accent-text);
    font-size: var(--site-font-small);
  }

  .join-status:empty {
    display: none;
  }

  .join-status.join-failed {
    color: var(--color-danger);
  }

  .join-field .button:disabled {
    opacity: var(--opacity-disabled);
    cursor: default;
  }

</style>
